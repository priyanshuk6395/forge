# Copy this file to .env and fill in the values.
# On a fresh install, `npm run setup` (also run automatically by userdata.sh)
# will generate SESSION_SECRET and ENCRYPTION_KEY for you.

# Port Forge itself listens on. userdata.sh grants the Node binary permission
# to bind port 80 directly, so the app is reachable with no port in the URL.
PORT=80

# 32-byte hex key used to encrypt secrets (GitHub tokens, AWS keys, project
# env vars) at rest. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Random string used to sign session cookies.
SESSION_SECRET=

# Where Forge stores its JSON database and encryption metadata. Must be
# writable by the user Forge runs as.
DATA_DIR=./data

# Optional: only needed if you want Forge to provision brand-new EC2
# instances for you (Section 9.5 Option A). If left blank, Forge still works
# fully for "connect an existing server" (Option B) — you just SSH-provide
# the IP of a box you already created any way you like.
# Leaving these blank is also fine if this Forge instance is itself running
# on an EC2 with an instance profile that has ec2:* permissions attached —
# Forge will fall back to the instance's IAM role automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
